# 智谱 AI 开放平台 API Key（在 https://open.bigmodel.cn 获取）
ZHIPU_API_KEY=
# JWT 签名密钥（生产环境请替换为随机长字符串）
JWT_SECRET=change-me-secret
# JWT 有效期（天）
JWT_EXPIRE_DAYS=7
# 数据库连接：SQLite 用 DB_PATH，PostgreSQL 用 DATABASE_URL（二选一，DATABASE_URL 优先）
DB_PATH=diet.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nutrimind
# 图片上传目录
UPLOAD_DIR=uploads
# 服务监听地址
HOST=0.0.0.0
# 服务监听端口
PORT=8000
# ---- 后台提醒（Web Push）----
# 留空则首次启动自动生成并写回本文件；更换密钥会使已订阅设备失效，请勿随意改动
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID 声明中的联系方式（mailto: 或 https: 开头）
VAPID_SUB=mailto:nutrimind@example.com
# 提醒调度器开关（0 关闭），默认开启
REMINDER_SCHEDULER=1
# 提醒所属时区（小时偏移，默认 +8）
REMINDER_UTC_OFFSET=8
# 调度心跳秒数（默认 60）
REMINDER_TICK_SECONDS=60
# 到点后的有效触发窗口（分钟，默认 15，超时不补发）
REMINDER_GRACE_MINUTES=15
